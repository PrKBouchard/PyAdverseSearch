msgstr "Node whose ancestors must be updated"

#: PyAdverseSearch.classes.pnsearch.PNSearch._extract_best_move:1 of
msgid "Extrait le meilleur coup d'une position prouvée gagnante."
msgstr "Extracts the best move from a proven winning position."

#: PyAdverseSearch.classes.pnsearch.PNSearch._extract_best_move:4 of
msgid "Nœud racine (doit être prouvé)"
msgstr "Root node (must be proven)"

#: PyAdverseSearch.classes.pnsearch.PNSearch._extract_best_move:5 of
