msgstr "Enables/disables the transpose table"

#: PyAdverseSearch.classes.pnsearch.PNSearch.choose_best_move:1 of
msgid ""
"Point d'entrée principal : trouve le meilleur coup depuis l'état donné."
msgstr "Main entry point: finds the best move from the given state."

#: PyAdverseSearch.classes.pnsearch.PNSearch.choose_best_move:5 of
msgid "Meilleur état enfant à jouer, ou None si aucun coup gagnant trouvé"
msgstr "Best child state to play, or None if no winning move found"

#: PyAdverseSearch.classes.pnsearch.PNSearch.pn_search:1 of
msgid "Algorithme principal de PN-Search."
msgstr "Main algorithm of PN-Search."

#: PyAdverseSearch.classes.pnsearch.PNSearch.pn_search:4 of
