msgstr "State resulting from the best move"

#: PyAdverseSearch.classes.pnsearch.PNSearch._extract_best_partial_move:1 of
msgid ""
"Extrait le meilleur coup d'une position non complètement résolue. Utilise "
"les valeurs phi/delta comme heuristique."
msgstr ""
"Extracts the best move from a not completely resolved position. Uses "
"phi/delta values ​​as a heuristic."

#: PyAdverseSearch.classes.pnsearch.PNSearch._extract_best_partial_move:6 of
msgid "État résultant du meilleur coup estimé"
msgstr "State resulting from the best estimated move"

#: PyAdverseSearch.classes.pnsearch.PNSearch._get_fallback_move:1 of
