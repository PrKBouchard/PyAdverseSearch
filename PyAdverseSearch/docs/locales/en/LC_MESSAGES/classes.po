msgstr "Node to extend"

#: PyAdverseSearch.classes.pnsearch.PNSearch.update_proof_numbers:1 of
msgid ""
"Met à jour les nombres de preuve et de réfutation d'un nœud en fonction de "
"ses enfants."
msgstr "Updates a node's proof and disproof numbers based on its children."

#: PyAdverseSearch.classes.pnsearch.PNSearch.update_proof_numbers:5 of
msgid "Nœud à mettre à jour"
msgstr "Node to update"

